# Copy to .env and adjust. The app runs fine with all defaults.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

SQLITE_PATH=db.sqlite3

# Production database. When set, this overrides SQLite. Use a POOLED connection
# string on serverless hosts (Supabase transaction pooler, port 6543).
# DATABASE_URL=postgresql://user:password@host:6543/postgres

# AI: "local" = deterministic engine only (no network, always works).
AI_BACKEND=local
AI_MODEL=
AI_API_KEY=

# ElevenLabs natural TTS (optional). Leave blank to use the browser's built-in
# voice. Get a free key at elevenlabs.io and paste it here to enable it.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5

# OCR: needs the Tesseract binary + pytesseract. Falls back to paste-text if absent.
OCR_BACKEND=tesseract
OCR_LANGUAGES=eng

# Privacy defaults
STORE_UPLOADS=0
MAX_UPLOAD_MB=15
ENABLE_LOCATION=0
ENABLE_SUPPORT_CIRCLE=1
PRIVACY_MIN_GROUP_SIZE=10
